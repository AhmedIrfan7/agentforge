# --- Python (apps/api) ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / TypeScript (apps/web, apps/widget, packages/shared) ---
node_modules/
.next/
dist/
build/
*.tsbuildinfo
.turbo/
playwright-report/
test-results/
blob-report/
pages-root/

# --- Env & secrets ---
.env
.env.*
!.env.example
!.env.prod.example

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
npm-debug.log*
pnpm-debug.log*

# --- Docker / local data volumes ---
.docker-data/

# --- Backups (roadmap step 265) -- real tenant data, never committed ---
backups/

# --- Terraform (roadmap step 278) -- .terraform.lock.hcl IS committed
# (Terraform's own convention), only the downloaded provider binaries
# and any real local state/plan output are not. ---
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfplan
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example

# --- Misc ---
*.tmp
