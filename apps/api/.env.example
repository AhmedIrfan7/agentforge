# Copy to .env and fill in for local development.
# Never commit the real .env file — it's gitignored.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-me-to-a-random-value-at-least-32-bytes-long

# --- Database (matches docker-compose.yml defaults) ---
# DATABASE_URL: least-privilege app role, subject to Row-Level Security —
# what the running application uses. See docs/adr/0003.
DATABASE_URL=postgresql+asyncpg://agentforge_app:agentforge_app@localhost:5432/agentforge
# DATABASE_MIGRATIONS_URL: bootstrap superuser, DDL rights — Alembic only.
DATABASE_MIGRATIONS_URL=postgresql+asyncpg://agentforge:agentforge@localhost:5432/agentforge
# Connection pool sizing (ignored in tests, which always use NullPool).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# --- Redis (cache, Celery broker/backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, S3-compatible) ---
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=agentforge
STORAGE_SECRET_KEY=agentforge123
STORAGE_BUCKET=agentforge-dev

# --- LLM / embedding providers (fill in your own keys) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Auth ---
JWT_SECRET=change-me-to-a-random-value-at-least-32-bytes-long
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- Google OAuth (roadmap step 076) ---
# From Google Cloud Console -> APIs & Services -> Credentials. Leave
# blank locally if you're not testing the Google login flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- MFA / TOTP (roadmap step 078) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=change-me-to-a-real-32-byte-key
MFA_TICKET_TTL_MINUTES=10

# --- Upload limits (roadmap step 086) ---
MAX_UPLOAD_SIZE_BYTES=52428800
