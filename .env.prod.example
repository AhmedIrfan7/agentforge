# Real production secrets for docker-compose.prod.yml (roadmap step 268).
# Copy to .env.prod and fill in real values — .env.prod is gitignored,
# same as .env. Every value below is REQUIRED — config.py's own
# _reject_placeholder_secrets_in_production validator (ENVIRONMENT is
# set to "production" by docker-compose.prod.yml itself) fails closed
# at startup if SECRET_KEY/JWT_SECRET/MFA_ENCRYPTION_KEY are still the
# dev placeholder values, and the compose file's own ${VAR:?...}
# syntax fails the same way for everything else here.

# --- Postgres ---
# POSTGRES_USER/PASSWORD: the bootstrap superuser (DDL/migrations only —
# see infra/postgres/init/01-app-role.sql's own docstring for why the
# running app never uses this role directly).
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=
# The real, unprivileged role the running app actually connects as —
# must match whatever password infra/postgres/init/01-app-role.sql sets
# for agentforge_app (edit that file's own CREATE ROLE line to match).
POSTGRES_APP_PASSWORD=

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=agentforge
MINIO_ROOT_PASSWORD=

# --- App secrets (generate real random values, never reuse the dev ones) ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# --- LLM / embedding providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Public URLs ---
# The real, publicly-reachable URL apps/web's own browser bundle should
# call — not http://api:8000 (that's only reachable inside the compose
# network), a real domain/IP this host is exposed on.
PUBLIC_API_URL=
APP_BASE_URL=

# --- Observability (optional — real code, inert until set, see
# docs/adr/0004-secrets-management.md) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
